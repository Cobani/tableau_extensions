<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.maturityladder" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Maturity ladder: amounts that fall due over time (contracts, leases, agreements by end date), one bar per week, month, quarter or year, stacked by an optional group, with a Today marker, an optional running total and overdue / later bars.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/maturity-ladder/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="date">
      <display-name resource-id="date-name">Maturity date</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="3"/>
      <tooltip resource-id="date-tooltip">Required. When each amount falls due: one exact date, or date parts such as YEAR and MONTH (up to 3 fields).</tooltip>
    </encoding>

    <encoding id="amount">
      <display-name resource-id="amount-name">Amount</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="amount-tooltip">Required. The measure that falls due (for example contract value). Negative amounts are drawn below zero.</tooltip>
    </encoding>

    <encoding id="color">
      <display-name resource-id="color-name">Group</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="color-tooltip">Optional. A dimension that stacks each bar (for example contract type).</tooltip>
    </encoding>

    <encoding id="detail">
      <display-name resource-id="detail-name">Item</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="detail-tooltip">Optional. One dimension with the individual items (for example the contract name): the largest are listed in the tooltip and the items are counted.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Maturity Ladder</text></resource>
    <resource id="date-name"><text locale="en_US">Maturity date</text></resource>
    <resource id="date-tooltip"><text locale="en_US">Required. When each amount falls due: one exact date, or date parts such as YEAR and MONTH (up to 3 fields).</text></resource>
    <resource id="amount-name"><text locale="en_US">Amount</text></resource>
    <resource id="amount-tooltip"><text locale="en_US">Required. The measure that falls due (for example contract value). Negative amounts are drawn below zero.</text></resource>
    <resource id="color-name"><text locale="en_US">Group</text></resource>
    <resource id="color-tooltip"><text locale="en_US">Optional. A dimension that stacks each bar (for example contract type).</text></resource>
    <resource id="detail-name"><text locale="en_US">Item</text></resource>
    <resource id="detail-tooltip"><text locale="en_US">Optional. One dimension with the individual items (for example the contract name): the largest are listed in the tooltip and the items are counted.</text></resource>
  </resources>
</manifest>
