<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.funnel" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Funnel chart: the stages of a process, each narrower than the one before, with the conversion and drop-off between them. One measure per stage, or a Stage dimension with a Value measure.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/funnel/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="steps">
      <display-name resource-id="steps-name">Stages (measures)</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="12"/>
      <tooltip resource-id="steps-tooltip">Optional. One measure per stage (2 to 12), in the order of this tile. Use this OR Stage + Value.</tooltip>
    </encoding>

    <encoding id="stage">
      <display-name resource-id="stage-name">Stage</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="stage-tooltip">Optional. One dimension whose members are the stages (use with Value). Order: Format &#8594; Chart &#8594; Order.</tooltip>
    </encoding>

    <encoding id="value">
      <display-name resource-id="value-name">Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="value-tooltip">Used with Stage: the measure that sizes each stage.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Funnel</text></resource>
    <resource id="steps-name"><text locale="en_US">Stages (measures)</text></resource>
    <resource id="steps-tooltip"><text locale="en_US">Optional. One measure per stage (2 to 12), in the order of this tile. Use this OR Stage + Value.</text></resource>
    <resource id="stage-name"><text locale="en_US">Stage</text></resource>
    <resource id="stage-tooltip"><text locale="en_US">Optional. One dimension whose members are the stages (use with Value). Order: Format &#8594; Chart &#8594; Order.</text></resource>
    <resource id="value-name"><text locale="en_US">Value</text></resource>
    <resource id="value-tooltip"><text locale="en_US">Used with Stage: the measure that sizes each stage.</text></resource>
  </resources>
</manifest>
