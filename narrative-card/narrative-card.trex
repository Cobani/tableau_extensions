<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.narrativecard" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Narrative card: sentences you write with live numbers inside, e.g. {Revenue} this month, {Revenue.change} vs last month..</description>
    <author name="ilyas coban" email="ilyas.cbn@gmail.com" organization="ilyas coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/narrative-card/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="measures">
      <display-name resource-id="measures-name">Measures</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="12"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="measures-tooltip">The numbers used in the text, 1 to 12. Drop each measure separately; write {Measure name} in the template to show its latest value.</tooltip>
    </encoding>

    <encoding id="date">
      <display-name resource-id="date-name">Date</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="4"/>
      <tooltip resource-id="date-tooltip">Optional. Any date level: year, quarter, month, week, day or exact date (add several, e.g. YEAR + MONTH, to combine). Needed for {Measure.change}, .previous and .date.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Narrative Card</text></resource>
    <resource id="measures-name"><text locale="en_US">Measures</text></resource>
    <resource id="measures-tooltip"><text locale="en_US">The numbers used in the text, 1 to 12. Drop each measure separately; write {Measure name} in the template to show its latest value.</text></resource>
    <resource id="date-name"><text locale="en_US">Date</text></resource>
    <resource id="date-tooltip"><text locale="en_US">Optional. Any date level: year, quarter, month, week, day or exact date (add several, e.g. YEAR + MONTH, to combine). Needed for {Measure.change}, .previous and .date.</text></resource>
  </resources>
</manifest>
