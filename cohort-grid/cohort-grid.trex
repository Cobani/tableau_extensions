<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.cohortgrid" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Cohort grid: a retention triangle. Cohorts down the side, periods since the start across the top, every cell shaded by its value, as a number or as a percentage of the cohort size.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/cohort-grid/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="cohort">
      <display-name resource-id="cohort-name">Cohort</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="cohort-tooltip">Required. One dimension: the group each row of the grid stands for, e.g. first-order month or sign-up week. Dates sort as dates.</tooltip>
    </encoding>

    <encoding id="period">
      <display-name resource-id="period-name">Period</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="period-tooltip">Required. One dimension: time since the cohort started. Either a number (0, 1, 2 ...) or a date, which is counted in months, weeks or days from the cohort date.</tooltip>
    </encoding>

    <encoding id="value">
      <display-name resource-id="value-name">Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="value-tooltip">Required. One measure: what each cell shows and is shaded by, e.g. number of active customers.</tooltip>
    </encoding>

    <encoding id="size">
      <display-name resource-id="size-name">Cohort size</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="size-tooltip">Optional. One measure: the size of the cohort (e.g. customers acquired), used for the percentages. Empty = the value in period 0.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Cohort Grid</text></resource>
    <resource id="cohort-name"><text locale="en_US">Cohort</text></resource>
    <resource id="cohort-tooltip"><text locale="en_US">Required. One dimension: the group each row of the grid stands for, e.g. first-order month or sign-up week. Dates sort as dates.</text></resource>
    <resource id="period-name"><text locale="en_US">Period</text></resource>
    <resource id="period-tooltip"><text locale="en_US">Required. One dimension: time since the cohort started. Either a number (0, 1, 2 ...) or a date, which is counted in months, weeks or days from the cohort date.</text></resource>
    <resource id="value-name"><text locale="en_US">Value</text></resource>
    <resource id="value-tooltip"><text locale="en_US">Required. One measure: what each cell shows and is shaded by, e.g. number of active customers.</text></resource>
    <resource id="size-name"><text locale="en_US">Cohort size</text></resource>
    <resource id="size-tooltip"><text locale="en_US">Optional. One measure: the size of the cohort (e.g. customers acquired), used for the percentages. Empty = the value in period 0.</text></resource>
  </resources>
</manifest>
