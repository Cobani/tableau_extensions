<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.parameterswitcher" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Parameter Switcher: shows the values of one Tableau parameter as tabs, buttons, pills, a dropdown, a toggle or a stepper, and sets the parameter when one is clicked.</description>
    <author name="ilyas coban" email="ilyas.cbn@gmail.com" organization="ilyas coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/parameter-switcher/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="options">
      <display-name resource-id="options-name">Options</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="options-tooltip">Optional. A dimension whose values become the choices (for parameters that allow all values). Leave empty to use the parameter&apos;s own list of values.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Parameter Switcher</text></resource>
    <resource id="options-name"><text locale="en_US">Options</text></resource>
    <resource id="options-tooltip"><text locale="en_US">Optional. A dimension whose values become the choices (for parameters that allow all values). Leave empty to use the parameter&apos;s own list of values.</text></resource>
  </resources>
</manifest>
