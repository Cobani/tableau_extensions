<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.linechart" extension-version="1.2.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Line and area chart: any number of measures over a date (or any dimension), each drawn as a line or an area; optional Color dimension, stacked and 100% areas, dual axis, reference lines, a band between two measures and an interactive legend.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/line-chart/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="date">
      <display-name resource-id="date-name">Date</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="4"/>
      <tooltip resource-id="date-tooltip">The horizontal axis. Any date level (year, quarter, month, week, day, exact date) or any other dimension. Add several (e.g. YEAR + MONTH) to combine.</tooltip>
    </encoding>

    <encoding id="measures">
      <display-name resource-id="measures-name">Measures</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="20"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="measures-tooltip">One line or area per measure. Drop each measure separately; choose line or area, axis and style per measure in Format → Series.</tooltip>
    </encoding>

    <encoding id="color">
      <display-name resource-id="color-name">Color</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="color-tooltip">Optional. A dimension that splits every measure into one series per member (e.g. Channel).</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Line Chart</text></resource>
    <resource id="date-name"><text locale="en_US">Date</text></resource>
    <resource id="date-tooltip"><text locale="en_US">The horizontal axis. Any date level (year, quarter, month, week, day, exact date) or any other dimension. Add several (e.g. YEAR + MONTH) to combine.</text></resource>
    <resource id="measures-name"><text locale="en_US">Measures</text></resource>
    <resource id="measures-tooltip"><text locale="en_US">One line or area per measure. Drop each measure separately; choose line or area, axis and style per measure in Format → Series.</text></resource>
    <resource id="color-name"><text locale="en_US">Color</text></resource>
    <resource id="color-tooltip"><text locale="en_US">Optional. A dimension that splits every measure into one series per member (e.g. Channel).</text></resource>
  </resources>
</manifest>
