<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.waterfall" extension-version="1.3.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Waterfall chart: a Start value, any number of changes and an End value, each dropped on the Marks card separately; optional breakdown dimension, groups, clipped-bar markers and header and number formatting.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/waterfall/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="start">
      <display-name resource-id="start-name">Start</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="start-tooltip">The opening value (first bar).</tooltip>
    </encoding>

    <encoding id="steps">
      <display-name resource-id="steps-name">Changes</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="30"/>
      <tooltip resource-id="steps-tooltip">The values between Start and End. Drop each measure separately; bars follow the order on this tile.</tooltip>
    </encoding>

    <encoding id="end">
      <display-name resource-id="end-name">End</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="end-tooltip">The closing value (last bar). Leave empty to calculate it as Start + changes.</tooltip>
    </encoding>

    <encoding id="breakdown">
      <display-name resource-id="breakdown-name">Breakdown</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="6"/>
      <tooltip resource-id="breakdown-tooltip">Optional dimensions that split each change bar into segments (e.g. account type, segment). Pick which ones each bar uses, and their order, in Format → Bars.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Waterfall</text></resource>
    <resource id="start-name"><text locale="en_US">Start</text></resource>
    <resource id="start-tooltip"><text locale="en_US">The opening value (first bar).</text></resource>
    <resource id="steps-name"><text locale="en_US">Changes</text></resource>
    <resource id="steps-tooltip"><text locale="en_US">The values between Start and End. Drop each measure separately; bars follow the order on this tile.</text></resource>
    <resource id="end-name"><text locale="en_US">End</text></resource>
    <resource id="end-tooltip"><text locale="en_US">The closing value (last bar). Leave empty to calculate it as Start + changes.</text></resource>
    <resource id="breakdown-name"><text locale="en_US">Breakdown</text></resource>
    <resource id="breakdown-tooltip"><text locale="en_US">Optional dimensions that split each change bar into segments (e.g. account type, segment). Pick which ones each bar uses, and their order, in Format → Bars.</text></resource>
  </resources>
</manifest>
