<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.calendarfilter" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Calendar Filter: a text box that shows the dates chosen and opens a calendar window to filter by year, month, week or day, with ranges, several values, quick ranges and null dates. Use it with a dashboard Filter action.</description>
    <author name="ilyas coban" email="ilyas.cbn@gmail.com" organization="ilyas coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/calendar-filter/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="date">
      <display-name resource-id="date-name">Date</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="date-tooltip">The date to filter, at day level: right-click it and choose Exact Date or Day (with the year). Date-times are grouped by day.</tooltip>
    </encoding>

    <encoding id="value">
      <display-name resource-id="value-name">Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="value-tooltip">Optional. A measure (e.g. a count of rows) shown in the calendar cells and used to shade them.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Calendar Filter</text></resource>
    <resource id="date-name"><text locale="en_US">Date</text></resource>
    <resource id="date-tooltip"><text locale="en_US">The date to filter, at day level: right-click it and choose Exact Date or Day (with the year). Date-times are grouped by day.</text></resource>
    <resource id="value-name"><text locale="en_US">Value</text></resource>
    <resource id="value-tooltip"><text locale="en_US">Optional. A measure (e.g. a count of rows) shown in the calendar cells and used to shade them.</text></resource>
  </resources>
</manifest>
