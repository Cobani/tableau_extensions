<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.sankey" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Sankey flow diagram: each dimension on Levels is a column of nodes, and the links between neighbouring columns are as thick as the summed Value. Hover to highlight a flow, click a node or link to select it in Tableau.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/sankey/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="levels">
      <display-name resource-id="levels-name">Levels</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="6"/>
      <tooltip resource-id="levels-tooltip">Required, 2 to 6 dimensions. Drop each dimension separately, outermost (left) first. Each one becomes a column of nodes; the order on this tile is the order of the columns.</tooltip>
    </encoding>

    <encoding id="value">
      <display-name resource-id="value-name">Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="value-tooltip">Required. One continuous measure (e.g. SUM(Sales)). It sets how thick each link is and how tall each node is. Zero, negative and empty values are not drawn.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Sankey</text></resource>
    <resource id="levels-name"><text locale="en_US">Levels</text></resource>
    <resource id="levels-tooltip"><text locale="en_US">Required, 2 to 6 dimensions. Drop each dimension separately, outermost (left) first. Each one becomes a column of nodes; the order on this tile is the order of the columns.</text></resource>
    <resource id="value-name"><text locale="en_US">Value</text></resource>
    <resource id="value-tooltip"><text locale="en_US">Required. One continuous measure (e.g. SUM(Sales)). It sets how thick each link is and how tall each node is. Zero, negative and empty values are not drawn.</text></resource>
  </resources>
</manifest>
