<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.bulletgauge" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Actual against target with qualitative ranges: bullet rows, semi-circular gauges or progress bars, one per category; optional comparison tick, % of target and status colors.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/bullet-gauge/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="category">
      <display-name resource-id="category-name">Category</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="2"/>
      <tooltip resource-id="category-tooltip">Optional: up to two dimensions, one row or gauge per member (e.g. store, region). Leave empty for a single mark for the whole worksheet.</tooltip>
    </encoding>

    <encoding id="actual">
      <display-name resource-id="actual-name">Actual</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="actual-tooltip">Required: the measured value (the bar or arc).</tooltip>
    </encoding>

    <encoding id="target">
      <display-name resource-id="target-name">Target</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="target-tooltip">Optional: the goal, drawn as a tick. Also gives the % of target.</tooltip>
    </encoding>

    <encoding id="ranges">
      <display-name resource-id="ranges-name">Ranges</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="3"/>
      <tooltip resource-id="ranges-tooltip">Optional: up to three measures, the upper limits of the bands (e.g. Poor / OK / Good). Drop each one separately. Without them, bands are percentages of the target.</tooltip>
    </encoding>

    <encoding id="compare">
      <display-name resource-id="compare-name">Comparison</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="compare-tooltip">Optional: a second value to compare with, e.g. last year, drawn as a thin tick.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Bullet &amp; Gauge</text></resource>
    <resource id="category-name"><text locale="en_US">Category</text></resource>
    <resource id="category-tooltip"><text locale="en_US">Optional: up to two dimensions, one row or gauge per member (e.g. store, region). Leave empty for a single mark for the whole worksheet.</text></resource>
    <resource id="actual-name"><text locale="en_US">Actual</text></resource>
    <resource id="actual-tooltip"><text locale="en_US">Required: the measured value (the bar or arc).</text></resource>
    <resource id="target-name"><text locale="en_US">Target</text></resource>
    <resource id="target-tooltip"><text locale="en_US">Optional: the goal, drawn as a tick. Also gives the % of target.</text></resource>
    <resource id="ranges-name"><text locale="en_US">Ranges</text></resource>
    <resource id="ranges-tooltip"><text locale="en_US">Optional: up to three measures, the upper limits of the bands (e.g. Poor / OK / Good). Drop each one separately. Without them, bands are percentages of the target.</text></resource>
    <resource id="compare-name"><text locale="en_US">Comparison</text></resource>
    <resource id="compare-tooltip"><text locale="en_US">Optional: a second value to compare with, e.g. last year, drawn as a thin tick.</text></resource>
  </resources>
</manifest>
