<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.ilyascoban.vizext.treemapdonut" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Treemap and donut chart: the composition of a whole, with drill-down through a hierarchy of dimensions. Size by one measure, optional colour measure.</description>
    <author name="Ilyas Coban" email="ilyas.cbn@gmail.com" organization="Ilyas Coban" website="https://www.linkedin.com/in/ilyascoban/"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://cobani.github.io/tableau_extensions/treemap-donut/</url>
    </source-location>
    <icon></icon>

    <!-- Adds the "Format Extension" button that opens configure.html -->
    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="category">
      <display-name resource-id="category-name">Category</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="4"/>
      <tooltip resource-id="category-tooltip">1 to 4 dimensions, outermost level first (e.g. Department, then Category, then Product). Each extra dimension is one more level to click into. Required.</tooltip>
    </encoding>

    <encoding id="value">
      <display-name resource-id="value-name">Size</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip resource-id="value-tooltip">The measure that sizes the tiles and slices. Required.</tooltip>
    </encoding>

    <encoding id="color">
      <display-name resource-id="color-name">Colour</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip resource-id="color-tooltip">Optional measure that shades the tiles (e.g. growth %). Colours: Measure in the Format window.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name"><text locale="en_US">Treemap &amp; Donut</text></resource>
    <resource id="category-name"><text locale="en_US">Category</text></resource>
    <resource id="category-tooltip"><text locale="en_US">1 to 4 dimensions, outermost level first (e.g. Department, then Category, then Product). Each extra dimension is one more level to click into. Required.</text></resource>
    <resource id="value-name"><text locale="en_US">Size</text></resource>
    <resource id="value-tooltip"><text locale="en_US">The measure that sizes the tiles and slices. Required.</text></resource>
    <resource id="color-name"><text locale="en_US">Colour</text></resource>
    <resource id="color-tooltip"><text locale="en_US">Optional measure that shades the tiles (e.g. growth %). Colours: Measure in the Format window.</text></resource>
  </resources>
</manifest>
